  <text decls="#source_1">
    <body>
      <div facs="#zone_headline">
        <head><hi rendition="#c #b"><lb/>Het Electrische Reproductie-Instrument</hi></head>
      </div>
      <div facs="#zone_brand_1">
        <head><hi rendition="#c #in #b"><lb/><name type="brand">Welte-Mignon</name></hi></head>
      </div>
      <div facs="#zone_text_1">
        <p><lb/><seg xml:id="topic_1" ana="#exact_reproduction" type="topic" resp="#claude">geeft natuurgetrouw het handspel der groote kunste-
          <lb/>naars weer</seg>. De loftuigingen der groote Meesters zijn
          <lb/>onbegrensd en Kunstenaars, als: <persName type="artist" corresp="https://d-nb.info/gnd/118501437">D’Albert</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/116029579">Backhaus</persName>,
          <lb/><persName type="artist" corresp="https://d-nb.info/gnd/118518011">Busoni</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118953915"><sic>Careno</sic></persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118697641">Grieg</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118986724"><sic>Paderewsky</sic></persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118598988">Reger</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/11875081X">Saint-
          <lb/>Saëns</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/11861911X">Strauss</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/116632658">Kwast-Hod<unclear>a</unclear>pp</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/116791748">Friedberg</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/123787548">Schäfer</persName>,
          <lb/><persName type="artist" corresp="https://d-nb.info/gnd/11863027X"><sic>Weingärtner</sic></persName>, kortom alle kunstenaars met wereld-
          <lb/>roem, schromen niet te verklaren, dat bij</p>
      </div>
      <div facs="#zone_brand_2">
        <ab><hi rendition="#c #in #b"><lb/><name type="brand">Welte-Mignon</name></hi></ab>
      </div>
      <div facs="#zone_text_2">
        <p><lb/><seg xml:id="topic_2" ana="#soulfulness" type="topic" resp="#claude">de diep verborgen krachten van den kunstenaar</seg>, n.l.
          <lb/><seg xml:id="topic_3" ana="#personality" type="topic" resp="#claude">zijn individueele aanslag, zijn opvatting en dynamiek</seg>,
          <lb/>zich fascineerend openbaren, èn dat</p>
      </div>
      <div facs="#zone_brand_3">
        <ab><hi rendition="#c #in #b"><lb/><name type="brand">Welte-Mignon</name></hi></ab>
      </div>
      <div facs="#zone_text_3">
        <p><lb/>het <seg xml:id="topic_4" ana="#superiority" type="topic" resp="#claude">eenige reproductie-instrument</seg> is, dat aanspraak
          <lb/>kan maken op <seg xml:id="topic_5" ana="#exact_reproduction" type="topic" resp="#claude">natuurgetrouwe weergave van het
          <lb/>handspel</seg>.</p>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#c #in #b"><lb/><orgName>HILGER</orgName>,</hi></ab>
      </div>
      <div facs="#zone_address">
        <ab><hi rendition="#c #b #larger"><lb/><address><addrLine>Wijker Brugstraat 18, Maastricht.</addrLine></address></hi></ab>
      </div>
    </body>
