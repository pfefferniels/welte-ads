  <text decls="#source_1">
    <body>
      <div facs="#zone_headline">
        <head><hi rendition="#b #in"><lb/>Brugt <name type="brand">Welte
          <lb/>Mignon</name> Flygel</hi></head>
      </div>
      <div facs="#zone_side">
        <ab><hi rendition="#c"><hi rendition="#b"><lb/><name type="brand">Steinway</name>
          <lb/>Salon</hi>
          <lb/><seg xml:id="topic_1" ana="#superiority" type="topic" resp="#claude">Verdens fineste
          <lb/>Kunstspilapparat</seg>
          <lb/><hi rendition="#b">anbefalet af
          <lb/>alle</hi> Nutidens</hi></ab>
      </div>
      <div facs="#zone_text">
        <p><lb/>største Musiknavne, haves paa Lager
          <lb/>og sælges med <hi rendition="#b">fuldtud betryg-
          <lb/>gende Garanti.</hi> Instrumentet er
          <lb/>fuldstændig som nyt, og der kan er-
          <lb/>holdes et Repertoire omfattende saa-
          <lb/>vel alle Klassikerne indspillet af
          <lb/>Verdens betydeligste Virtuoser, som
          <lb/><seg xml:id="topic_2" ana="#popular" type="topic" resp="#claude">Øjeblikkets kendte og populære
          <lb/><seg xml:id="topic_3" ana="#dance" type="topic" resp="#claude">Danse</seg></seg>.</p>
      </div>
      <div facs="#zone_text2">
        <p><lb/>Instrumentet demonstreres og fore-
          <lb/>vises daglig og indbyder vi alle Mu-
          <lb/>sikinteresserede til et Besøg i vort
          <lb/>Magasin.</p>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#c"><lb/><hi rendition="#b #in"><orgName>A/S Chr. Winther</orgName>,</hi>
          <lb/><hi rendition="#b"><address><addrLine>Frederiksborggade 36.</addrLine></address></hi>
          <lb/>Grundl. 1885.</hi></ab>
      </div>
    </body>
  </text>
