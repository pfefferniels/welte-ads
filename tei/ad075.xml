  <text decls="#source_1">
    <body>
      <div facs="#zone_headline">
        <head><lb/><hi rendition="#b #in">„<name type="brand">Mignon</name>“</hi> – Reproduktionsklavér.</head>
      </div>
      <div type="illustration" facs="#zone_picture">
        <figure><desc>The Welte-Mignon cabinet player (Vorsetzer) in an Art Nouveau case</desc></figure>
      </div>
      <div facs="#zone_left">
        <ab><hi rendition="#c"><seg xml:id="topic_1" ana="#home" type="topic" resp="#claude"><lb/>Elegant
          <lb/>Ydre.
          <lb/>En Pryd
          <lb/>for enhver
          <lb/>Salon.</seg></hi></ab>
      </div>
      <div facs="#zone_right">
        <ab><hi rendition="#c"><seg xml:id="topic_2" ana="#technical_invention" type="topic" resp="#claude"><lb/>Drives ved
          <lb/>Elektro-
          <lb/>motor</seg>; kan
          <lb/>tilkobles
          <lb/>hvilken-
          <lb/>somhelst
          <lb/>Lysledning.</hi></ab>
      </div>
      <div facs="#zone_text">
        <ab><lb/><seg xml:id="topic_3" ana="#exact_reproduction" type="topic" resp="#claude">Gjengiver direkte Virtuosernes Spil med alle Finheder</seg>
          <lb/>og <seg xml:id="topic_4" ana="#personality" type="topic" resp="#claude">alle individuelle Karaktéregenskaber</seg>.</ab>
      </div>
      <div facs="#zone_extracts">
        <ab><lb/>Uddrag af nogle Udtalelser:</ab>
      </div>
      <div facs="#zone_dohnanyi">
        <ab><lb/><hi rendition="#b"><persName type="artist" corresp="https://d-nb.info/gnd/119110016">Ernst v. Dohnányi</persName>:</hi>
          <quote type="testimonial">
            <lb/>Ved Opførelsen af <hi rendition="#b">„<name type="brand">Mignon</name>“</hi> er det nu <sic>lykkes</sic> <seg xml:id="topic_5" ana="#exact_reproduction" type="topic" resp="#claude">paa det nøiagtigste
            <lb/>at gjengive enhvers Spil</seg> og <seg xml:id="topic_6" ana="#immortality" type="topic" resp="#claude">bevare dette for kommende Tider</seg>. <seg xml:id="topic_7" ana="#miracle" type="topic" resp="#claude">Man kan kun
            <lb/>forbauses og beundre</seg>.
          </quote></ab>
      </div>
      <div facs="#zone_gruenfeld">
        <ab><lb/><hi rendition="#b"><persName type="artist" corresp="https://d-nb.info/gnd/116888652">Alfred Grünfeld</persName>:</hi>
          <quote type="testimonial">
            <lb/>De af mig spillede Stykker blev gjengivet <seg xml:id="topic_8" ana="#exact_reproduction" type="topic" resp="#claude">med alle af mig indlagte
            <lb/>Nuancer</seg> og <seg xml:id="topic_9" ana="#virtual_presence" type="topic" resp="#claude">saa skuffende ligt, at mine nærværende Venner havde Følelsen af,
            <lb/>at jeg selv sad ved Flyglet</seg>.
          </quote></ab>
      </div>
      <div facs="#zone_artists">
        <ab><lb/>Noderne er indspillet af alle store Componister og Pianister som:
          <lb/><hi rendition="#b"><persName type="artist" corresp="https://d-nb.info/gnd/118697641">Grieg</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118986724">Paderewski</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/119110016">Dohnányi</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118953915">Carréno</persName></hi> etc.</ab>
      </div>
      <div facs="#zone_demonstration">
        <ab><hi rendition="#c #b"><lb/>Forespilles daglig Interessenter.</hi></ab>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#c #b"><lb/><hi rendition="#in"><orgName>Grøndahls Flygel- &amp; Pianolager</orgName></hi>
          <lb/><address><addrLine>Carl Joh.s Gd. 17. Telef. 7899.</addrLine></address></hi></ab>
      </div>
    </body>
