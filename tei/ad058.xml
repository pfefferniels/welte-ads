      <div facs="#zone_lead">
        <ab><hi rendition="#c">
          <lb/>Als
          <lb/>Reproductie
          <lb/>Piano is de
        </hi></ab>
      </div>
      <div facs="#zone_brand">
        <head><hi rendition="#c #in"><lb/><name type="brand">Estey-Welte</name></hi></head>
      </div>
      <div facs="#zone_masterpiece">
