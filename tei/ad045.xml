    <body>
      <div facs="#zone_venue">
        <ab><hi rendition="#c #b #larger"><lb/><placeName>Salle du Conservatoire</placeName></hi></ab>
      </div>
      <div facs="#zone_date">
        <ab><hi rendition="#c"><lb/>Mardi 8 novembre<unclear>,</unclear> à 20 h 30</hi></ab>
      </div>
      <div facs="#zone_headline">
        <head><hi rendition="#c #b #in #g"><lb/>RÉCITAL DE PIANO</hi></head>
      </div>
      <div facs="#zone_brand">
        <ab><hi rendition="#c">
          <lb/>exécuté par le
          <lb/><hi rendition="#larger #g"><name type="brand">Steinway-Welte</name></hi></hi></ab>
      </div>
      <div facs="#zone_text">
        <p>
          <lb/><seg xml:id="topic_1" ana="#exact_reproduction" type="topic" resp="#claude">reproduction intégrale et scrupuleusement fidèle
          <lb/>du jeu de quelques <sic>maître</sic> du clavier</seg>, dont : <persName type="artist" corresp="https://d-nb.info/gnd/118501437">Eugène
          <lb/>d’Albert</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/117223794">Stavenhagen</persName><unclear>,</unclear> <persName type="artist" corresp="https://d-nb.info/gnd/118524186">Debussy</persName><unclear>,</unclear> etc.
          <lb/>Au programme: <persName type="composer" corresp="https://d-nb.info/gnd/11850553X">Bach</persName><unclear>,</unclear> <persName type="composer" corresp="https://d-nb.info/gnd/118584596">Mozart</persName>, <persName type="composer" corresp="https://d-nb.info/gnd/118508288">Beethoven</persName>, <persName type="composer" corresp="https://d-nb.info/gnd/118610961">Schu-
          <lb/>bert</persName><unclear>,</unclear> <persName type="composer" corresp="https://d-nb.info/gnd/118520539">Chopin</persName><unclear>,</unclear> <persName type="composer" corresp="https://d-nb.info/gnd/118573527">Liszt</persName><unclear>,</unclear> <persName type="composer" corresp="https://d-nb.info/gnd/118524186">Debussy</persName><unclear>,</unclear> <persName type="composer" corresp="https://d-nb.info/gnd/118642545">Stravinsky</persName>, etc.
          <lb/>Ce concert <unclear>é</unclear>tant donné à bureaux fermés, prière
          <lb/>de s’adresser à la maison <orgName>Kneifel-Béroud</orgName>, pianos<unclear>,</unclear>
          <lb/><address><addrLine>2<unclear>0</unclear>, Terraillet</addrLine></address>, qui enverra des invitations à toutes
          <lb/>personnes qui en feront la demande.
        </p>
      </div>
