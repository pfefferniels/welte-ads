      <div facs="#zone_subhead">
        <ab><hi rendition="#c"><lb/><seg xml:id="topic_1" ana="#superiority" type="topic" resp="#claude">Verdens fineste Kunstspilapparat</seg>
          <lb/>til Gengivelse af Kunstnerens Spil.</hi></ab>
      </div>
      <div facs="#zone_steinway">
        <ab><hi rendition="#c #b"><lb/>Indbygget i <name type="brand">Steinway</name>.</hi></ab>
      </div>
      <div facs="#zone_testimonial">
        <ab><lb/><hi rendition="#b"><persName type="artist" corresp="https://d-nb.info/gnd/11875081X">Camille Saint Saëns</persName></hi> skriver:
          <quote type="testimonial">
            <lb/>›<foreign xml:lang="de">Kennst du das Land</foreign>‹? Ken-
            <lb/>der Du Landet, hvor Underet
            <lb/>blomstrer.
            <lb/>›<seg xml:id="topic_2" ana="#miracle" type="topic" resp="#claude">Underet er ›<name type="brand">Welte Mignon</name>‹</seg>,
            <lb/>et beskedent Navn for en beun-
            <lb/>dringsværdig Ting. Man maa
            <lb/>kun beklage at denne Opfindelse
            <lb/>ikke allerede blev gjort tidli-
            <lb/>gere; <seg xml:id="topic_3" ana="#immortality" type="topic" resp="#claude">thi da kunde vi endnu
            <lb/>den Dag i Dag høre <persName type="composer" corresp="https://d-nb.info/gnd/118508288">Beethoven</persName>,
            <lb/><persName type="composer" corresp="https://d-nb.info/gnd/118584596">Mozart</persName> og <persName type="composer" corresp="https://d-nb.info/gnd/118520539">Chopin</persName> selv spille</seg>‹
          </quote></ab>
      </div>
      <div facs="#zone_prospekt">
        <ab><hi rendition="#c #b"><lb/>Forlang Prospekt.
          <lb/>Forevises uden Købetvang.</hi></ab>
      </div>
