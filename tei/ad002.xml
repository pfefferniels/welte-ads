    <text>
        <div facs="#eSc_textblock_183da727">
            <lb />
            <hi rendition="#c">
                <hi rendition="#i">
                    <hi rendition="#u">
                        <seg xml:id="immortals" ana="#immortality" resp="#np" type="topic">
                            The Instrument of the Immortals
                        </seg>
                        <note type="editorial" ref="#immortals" resp="#np">
                            The slogan was originally invented by
                            <persName>Raymond Rubicam</persName> in 1919, who
                            referred to the long-lasting history of Steinway pianos
                            (Julian Watkins, *The 100 Greatest Advertisements 1852–1958*,
                            p. 45).
                            Nevertheless, the "immortality" theme is analysed 
                            here, since the slogan gets reinterpreted by its 
                            context.
                        </note>
                    </hi>
                </hi>
            </hi>
        </div>
        <div facs="#zone_head">
            <lb />
            <hi rendition="#c #uc">
            <head>
                <name type="brand">
                    <hi rendition="#larger">Steinway</hi>
                    <lb />Welte
                    <lb />Grand
                </name>
            </head>
            </hi>
        </div>
        <div type="illustration" facs="#eSc_textblock_732637de">
            <figure>
                <desc>Steinway grand piano with an oval portrait photograph of Paderewski</desc>
            </figure>
        </div>
        <div facs="#eSc_dummyblock_">
            <lb />The <name type="brand">Welte-Mignon</name>, which<lb />
            <seg ana="#exact_reproduction" resp="#np" type="topic">
                reproduces absolutely the
                <lb />Artists' original renderings
            </seg>,
            <lb />retains its position amongst
            <lb />the World's foremost and
            <lb />greatest reproducing instru-
            <lb />ments.
            <lb /><lb />The <name type="brand">Steinway
            Welte</name> is
            <lb />made also as a self-contained
            <lb />upright piano. Welte cabi-
            <lb />nets when desired can be
            <lb />supplied separately for at-
            <lb />tachment to any pianoforte.
            <lb /><lb /><hi rendition="#c #i #smaller">Renderings
            by:</hi>
        </div>
        <div facs="#eSc_textblock_6984ced5">
            <lb />
            <persName type="artist" corresp="https://d-nb.info/gnd/118986724">Paderewski</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/116014490">Pachmann</persName>,
            <lb />
            <persName type="artist" corresp="https://d-nb.info/gnd/118518011">Busoni</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/11918625X">Josef Hofmann</persName>,
            <lb />
            <persName type="artist" corresp="https://d-nb.info/gnd/116422319">Mark Hambourg</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/134788370">Pouish-<lb />noff</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/116040378">Fanny Davies</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/118501437">
                d'Al-<lb />bert
            </persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/116204400">Bloomfield-Zeisler</persName>,
            <lb />
            <persName type="artist" corresp="https://d-nb.info/gnd/118953915">Carreño</persName>,
            <persName>
                Debussy
            </persName>,
            <persName>
                Doh-<lb />nányi
            </persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/118697641">Grieg</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/116888652">Grünfeld</persName>,
            <lb /><persName type="artist" corresp="https://d-nb.info/gnd/116662166">Lamond</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/120890143">Leschetizky</persName>,
            <lb />
            <persName type="artist" corresp="https://d-nb.info/gnd/124379923">Lhevinne</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/116308621">Pugno</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/11875081X">Saint-<lb />Saens</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/119466821">Samaroff</persName>,
            <persName type="artist">Sapellni-<lb />koff</persName>,
            <persName type="artist" corresp="https://d-nb.info/gnd/117110450">Scharwenka</persName>,
            <persName type="artist">Schelling</persName>,
            <lb /><persName type="artist" corresp="https://d-nb.info/gnd/11861911X">Strauss</persName>,
            <persName type="artist">Schumann</persName>, etc.
        </div>
        <div facs="#eSc_textblock_9478645f">
            <lb />
            <seg type="topic" resp="#np" ana="#distinction_from_mechanical">
                <hi rendition="#dropcap">U</hi><hi rendition="#uc">ntil</hi> the <name type="brand">Welte-Mignon</name>
                <lb />made its appearance all the
                <lb />piano-playing <sic>'</sic>instruments
                <lb />aimed at making the interpretation
                <lb />of a piece of music mechanically
                <lb />correct;
            </seg>
            the <name type="brand">Welte-Mignon</name>
            <lb />caught the great masters in the act of
            <lb />playing, and
            <seg ana="#immortality" resp="#np" type="topic">fixed their style for ever</seg>. 
        </div>
