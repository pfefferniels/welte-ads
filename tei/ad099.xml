  <text decls="#source_1">
    <body>
      <div type="illustration" facs="#zone_picture">
        <figure xml:id="figure_1" ana="#sitting_woman #listening" resp="#claude"><desc>A woman in evening dress playing a grand piano; a man in an armchair at left and a man seated on a stool at right listen</desc></figure>
      </div>
      <div facs="#zone_headline">
        <head><hi rendition="#b #in"><lb/><name type="brand">Welte
          <lb/>Mignon</name>
          <lb/>&amp;</hi></head>
      </div>
      <div facs="#zone_other">
        <ab><gap reason="irrelevant"><desc resp="#claude">name of the other product (Ducanola.)</desc></gap></ab>
      </div>
      <div facs="#zone_intro">
        <ab><hi rendition="#c"><lb/><seg xml:id="topic_1" ana="#superiority" type="topic" resp="#claude">De to ypperste Kunstspilinstrumenter, der findes</seg>, kendt Verden
          <lb/>over beundret og anbefalet af alle de største Musiknavne.</hi></ab>
      </div>
      <div facs="#zone_welte">
        <p><hi rendition="#b #in"><lb/><name type="brand">Welte Mignon</name></hi> indbygget <name type="brand">Steinway</name> Flygler og Pianoer, drives ved Elektricitet, men kan og
          <lb/>saa benyttes til Haandspil. Dets <seg xml:id="topic_2" ana="#exact_reproduction" type="topic" resp="#claude">Gengivelse af Kunstnerens Spil er saa nøj-
          <lb/>agtigt og fuldendt</seg>, <seg xml:id="topic_3" ana="#virtual_presence" type="topic" resp="#claude">som sad han selv foran Instrumentet</seg></p>
      </div>
      <div facs="#zone_other2">
        <ab><gap reason="irrelevant"><desc resp="#claude">3-line paragraph on the other product (Ducanola)</desc></gap></ab>
      </div>
      <div facs="#zone_realiserer">
        <p><hi rendition="#b #in"><lb/>Vi realiserer</hi> forskellige fine 1ste Kl.s selvspillende Instrumenter og Forsatsapparater til
          <lb/><hi rendition="#b">meget billige Priser.</hi>
          <lb/><hi rendition="#b">Vi indbygger</hi> Spilleapparat i Deres Piano eller Flygel.</p>
      </div>
      <div facs="#zone_priser">
        <p><hi rendition="#b #in"><lb/>Vore Priser</hi> <seg xml:id="topic_4" ana="#affordability" type="topic" resp="#claude">er de billigste, vore Betalingsvilkaar yderst kulante</seg> og vor Garanti den mest
          <lb/>betryggende</p>
      </div>
      <div facs="#zone_bytte">
        <ab><hi rendition="#c #b"><lb/>Brugte Flygler og Pianoer tages i Bytte.</hi></ab>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#b"><lb/><hi rendition="#in"><orgName>A/S Chr. Winther</orgName>,</hi>
          <lb/><address><addrLine>Frederiksborggade 36. (Nørrehus).</addrLine></address></hi></ab>
      </div>
      <div facs="#zone_firm">
        <ab><hi rendition="#c #b #smaller"><lb/>Skandinaviens største Magasin for Flygler, Pianoer,
          <lb/>Harmoniums og pneumatiske Instrumenter.
          <lb/>— Grundlagt 1885. —</hi></ab>
      </div>
    </body>
  </text>
