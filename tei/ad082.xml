  <text decls="#source_1">
    <body>
      <div facs="#zone_intro">
        <head><hi rendition="#c #i #g"><lb/>Den berømte russiske pianist</hi></head>
      </div>
      <div facs="#zone_name">
        <head><hi rendition="#c #in"><lb/><persName type="artist" corresp="https://d-nb.info/gnd/124379923">Lhévinne</persName></hi></head>
      </div>
      <div facs="#zone_recording">
        <ab><hi rendition="#c"><lb/>som f. t. gjæster <placeName>Kristiania</placeName> har latt sit klaverspil
          <lb/>opta av det elektriske reproduktionsinstrument</hi></ab>
      </div>
      <div facs="#zone_brand">
        <head><hi rendition="#c #b #in #u"><lb/><name type="brand">The Welte-Mignon</name></hi></head>
      </div>
      <div facs="#zone_testimonial_head">
        <ab><lb/>Om instrumentets gjengivelse uttaler <persName type="artist" corresp="https://d-nb.info/gnd/124379923">Lhévinne</persName>:</ab>
      </div>
      <div facs="#zone_testimonial">
        <quote type="testimonial">
          <p><lb/>Efter at ha endt min concertturne i <placeName>U. S. A.</placeName> har
            <lb/>jeg idag for første gang hørt gjengit de komposi-
            <lb/>tioner som jeg spilte for <hi rendition="#b"><name type="brand">The Welte Mignon</name></hi> — gjengit
            <lb/>av <hi rendition="#b"><name type="brand">The Welte Mignon</name></hi> reproduktionsapparat <seg xml:id="topic_1" ana="#exact_reproduction" type="topic" resp="#claude">med en
            <lb/>absolut nøiagtighet saavel hvad angaar tempo, an-
            <lb/>slag og tonkvalitet som den correcte nuancering av
            <lb/>foredraget</seg>.</p>
          <p><lb/>I sandhet — <seg xml:id="topic_2" ana="#personality" type="topic" resp="#claude">instrumentet gjengir til fuldkommen-
            <lb/>het min fortolkning av kompositionen</seg>.</p>
        </quote>
      </div>
      <div facs="#zone_models">
        <ab><hi rendition="#c"><lb/><hi rendition="#b #larger"><name type="brand">The Welte-Mignon</name></hi>
          <lb/>faaes i følgende utførelser:</hi></ab>
      </div>
      <div facs="#zone_cabinet_player">
        <ab><lb/><hi rendition="#in"><name type="brand">The Welte Cabinet Player</name></hi>
          <lb/><hi rendition="#right">kan tilsættes ethvert piano eller flygel.</hi></ab>
      </div>
      <div facs="#zone_autograph_piano">
        <ab><lb/><hi rendition="#in"><name type="brand">The Welte Autograph Piano</name></hi>
          <hi rendition="#right #larger"><lb/><name type="brand">Steinway &amp; Sons</name>
          <lb/><name type="brand">Mason &amp; Hamlin</name></hi></ab>
      </div>
      <div facs="#zone_autograph_grand">
        <ab><lb/><hi rendition="#in"><name type="brand">The Welte Autograph Grand</name></hi></ab>
      </div>
      <div facs="#zone_signature">
