  <text decls="#source_1">
    <body>
      <div facs="#zone_headline">
        <head><hi rendition="#b #i"><lb/>Heden ontpakt:</hi></head>
      </div>
      <div facs="#zone_subhead">
        <ab><hi rendition="#c #larger"><lb/>EEN REPRODUCTIONS PIANO</hi></ab>
      </div>
      <div facs="#zone_brand">
        <head><hi rendition="#c #in #b"><lb/><name type="brand">Welte Mignon</name>.</hi></head>
      </div>
      <div facs="#zone_text">
        <p><hi rendition="#b"><lb/>Dit is <seg xml:id="topic_1" ana="#superiority" type="topic" resp="#claude">het fraaiste, beste en nieuwste instrument</seg>,
          <lb/>dat tot heden op dat gebied in den handel
          <lb/>gebracht en nog niet op <placeName>Java</placeName> geimporteerd is.
          <lb/>Het eerste exemplaar door mij nu verkocht aan
          <lb/>een Administrateur in de <placeName>Preanger</placeName> wordt tot en
          <lb/>met 15 October voor belangstellenden tentoon-
          <lb/>gesteld bij den alleenvertegenwoordiger.</hi></p>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#c"><lb/><hi rendition="#in #b"><orgName>Edmund Salzmann</orgName>,</hi>
          <lb/><hi rendition="#b #i #smaller">Piano- en Muziekhandel,</hi>
          <lb/><hi rendition="#b"><address><addrLine>NOORDWIJK No. 12, WELTEVREDEN.</addrLine></address></hi></hi></ab>
      </div>
      <div facs="#zone_attest">
        <ab><hi rendition="#b #larger"><lb/>Attesten liggen ter inzage.</hi></ab>
      </div>
      <div facs="#zone_number">
        <ab><hi rendition="#right #smaller"><lb/>8986</hi></ab>
      </div>
    </body>
