                    </category>
                    <category xml:id="touch_of_a_button">
                       <gloss>Touch of a Button</gloss>
                       <desc>The Welte-Mignon is permanently available and "objectified"
                          for the entertainment of the owner – on the touch of a
                          button.</desc>
                    </category>
                    <category xml:id="virtual_presence">
                       <gloss>Virtual Presence</gloss>
                    </category>
                </taxonomy>
