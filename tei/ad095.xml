  <text decls="#source_1">
    <body>
      <div facs="#zone_headline">
        <head><hi rendition="#b #in"><lb/><name type="brand">Welte Mignon</name> Koncert,</hi></head>
      </div>
      <div facs="#zone_text">
        <p><hi rendition="#b"><lb/><seg xml:id="topic_1" ana="#superiority" type="topic" resp="#claude">Verdens fineste Kunstspilleapparat</seg>,
          <lb/>indbygget i <name type="brand">Steinway</name> Flygel og Piano,
          <lb/><seg xml:id="topic_2" ana="#exact_reproduction" type="topic" resp="#claude">gengiver indtil de mindste Enkelt-
          <lb/>heder vore største og mest berømte
          <lb/>Kunstneres Spil</seg>. Demonstreres dag-
          <lb/>lig, og indbydes enhver musikinter-
          <lb/>esseret til at høre dette fremragende
          <lb/>Instrument.</hi></p>
      </div>
      <div facs="#zone_program">
        <ab><hi rendition="#b"><lb/><name type="brand">Welte Mignon</name> Program omfatter hele
          <lb/>Klaverlitteraturen.</hi></ab>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#b #in"><lb/><orgName>A/S Chr. Winther</orgName>,</hi></ab>
      </div>
      <div facs="#zone_address">
        <ab><hi rendition="#c #b"><address><lb/><addrLine>Frederiksborgg.36,</addrLine>
          <lb/><addrLine>Nørrehus.</addrLine></address></hi></ab>
      </div>
