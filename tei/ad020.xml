           <classDecl>
              <taxonomy xml:id="topics">
                 <desc>Topics: recurring motifs of the advertisements, in their texts
                    and in their pictures</desc>
                 <category xml:id="distinction_from_mechanical">
                    <gloss>Distinction from Mechanical</gloss>
                    <desc>Often, the adverts try to distinguish reproducing piano rolls
                       from mere mechanical methods (such as the player piano).</desc>
                 </category>
                 <category xml:id="exact_reproduction">
                    <gloss>Exact Reproduction</gloss>
                    <desc>In virtually all promotional materials between 1905 and 1926,
                       the claim of exact and faithful reproduction, of absolute
                       accurateness is consistently emphasized.</desc>
                 </category>
                 <category xml:id="home">
                    <gloss>Home</gloss>
                 </category>
                 <category xml:id="personality">
                    <gloss>Personality</gloss>
                 </category>
                 <category xml:id="secret">
                    <gloss>Secret</gloss>
                    <desc>Perfect reproduction and its manufacturing is a secret
                       possessed only by the Welte-Mignon company.</desc>
                 </category>
                 <category xml:id="virtual_presence">
                    <gloss>Virtual Presence</gloss>
                 </category>
              </taxonomy>
           </classDecl>
