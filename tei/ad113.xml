  <text decls="#source_1">
    <body>
      <div type="illustration" facs="#zone_picture">
        <figure xml:id="figure_1" ana="#home"><desc>A grand piano in a room, a curtained leaded window, an armchair and a vase of flowers behind</desc></figure>
      </div>
      <div facs="#zone_headline">
        <head><lb/><hi rendition="#larger">Ye Olde Firme</hi>
          <lb/><hi rendition="#larger"><orgName>Heintzman &amp; Co.</orgName></hi>
          <lb/><hi rendition="#in"><name type="brand">Welte-Mignon Reproducing Pianos</name></hi></head>
      </div>
      <div facs="#zone_text">
        <p><hi rendition="#g #smaller"><lb/>The <name type="brand">Heintzman &amp; Co. Welte-Mignon Reproducing Piano</name>
          <lb/>represents <seg xml:id="topic_1" ana="#unreached_ideal" type="topic" resp="#claude">the ultimate in musical perfection</seg>. It brings
          <lb/><seg xml:id="topic_2" ana="#home" type="topic" resp="#claude">the actual playing of the world’s greatest artists into
          <lb/>your home</seg>, <seg xml:id="topic_3" ana="#exact_reproduction" type="topic" resp="#claude">reproducing each composition with absolute
          <lb/>faithfulness</seg>—with all the ease and grace, the power and
          <lb/>force, <seg xml:id="topic_4" ana="#personality" type="topic" resp="#claude">by which the artists wove their own personality
          <lb/>into the playing</seg>.
          <lb/>If you will visit our Music Salons the <name type="brand">Heintzman &amp; Co.
          <lb/>Welte-Mignon Reproducing Piano</name> will gladly play for
          <lb/>you the music you like best.</hi></p>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#c"><lb/><hi rendition="#b #i">Ye Olde Firme</hi>
          <lb/><hi rendition="#in #larger"><orgName>Heintzman &amp; Co.</orgName></hi>
          <lb/><hi rendition="#b"><address><addrLine>193-197 Yonge Street, - - - - - TORONTO</addrLine></address></hi></hi></ab>
      </div>
    </body>
