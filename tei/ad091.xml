  <text decls="#source_1">
    <body>
      <div facs="#zone_headline">
        <head><hi rendition="#c #b #in"><lb/>Kunstmusik</hi></head>
      </div>
      <div facs="#zone_left_1">
        <p><lb/>Ved Nærværende tillader vi os
          <lb/>at meddele, at vi atter har Kunst-
          <lb/>spilleapparatet</p>
      </div>
      <div facs="#zone_left_brand">
        <ab><hi rendition="#c #b #in"><lb/>„<name type="brand">Welte Mignon</name>“</hi></ab>
      </div>
      <div facs="#zone_left_2">
        <p><lb/><sic><unclear>in</unclear>dbyggget</sic> i <hi rendition="#b"><name type="brand">Steinway</name> Flygel</hi> og
          <lb/><hi rendition="#b">Piano</hi> og som selvstændig <hi rendition="#b">Forsats-
          <lb/>apparat</hi> paa Lager.</p>
      </div>
      <div facs="#zone_middle_brand">
        <ab><hi rendition="#c #b #in"><lb/>„<name type="brand">Welte Mignon</name>“</hi></ab>
      </div>
      <div facs="#zone_middle">
        <p><lb/>anses som <seg xml:id="topic_1" ana="#superiority" type="topic" resp="#claude">det mest epoke-
          <lb/>gørende Kunstspilleapparat,
          <lb/>der findes</seg>, idet Apparatet <seg xml:id="topic_2" ana="#exact_reproduction" type="topic" resp="#claude">gen-
          <lb/>giver <hi rendition="#b">Kunstnerens Spil paa
          <lb/>den mest nøjagtige og fuld-
          <lb/>komne Maade.</hi></seg></p>
      </div>
      <div facs="#zone_right">
        <p><hi rendition="#b"><lb/>Vor Tids største Musiknavne:</hi>
          <lb/><hi rendition="#i"><persName type="artist" corresp="https://d-nb.info/gnd/11875081X">Saint Saëns</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118986724">Paderewski</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118779559">Leonca-
          <lb/>vallo</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118786253">Arthur Nikisch</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118697641">Grieg</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/11861911X">Richard
          <lb/>Strauss</persName>, <persName type="composer" corresp="https://d-nb.info/gnd/118596942">Puccini</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/118598988">Max Reger</persName>, <persName type="artist" corresp="https://d-nb.info/gnd/11855476X"><sic>Hum-
          <lb/>perdinch</sic></persName> m. m. fl.</hi>, har udtalt sig i
          <lb/>de mest <hi rendition="#b">rosende</hi> og <hi rendition="#b">begejstrede
          <lb/>Vendinger</hi> om <hi rendition="#b">„<app><rdg source="#source_1"><name type="brand">Welte Mignon</name></rdg><rdg source="#source_2"><name type="brand"><sic>Welte Wignon</sic></name></rdg></app>“</hi>,
          <lb/>som de <hi rendition="#b">anser for en <seg xml:id="topic_3" ana="#technical_invention" type="topic" resp="#claude">banebrydende
          <lb/>Opfindelse</seg> paa Musikens Om-
          <lb/>raade.</hi></p>
      </div>
      <div facs="#zone_invitation">
        <ab><hi rendition="#c #b"><lb/>Nutidens største Klavervirtuoser kan hver Dag høres i vort Magasin.</hi></ab>
      </div>
      <div facs="#zone_address">
        <ab><hi rendition="#c #b"><address><lb/><addrLine>Frederiksborggade 36</addrLine>
          <lb/><addrLine>Nørrehus.</addrLine></address></hi></ab>
      </div>
      <div facs="#zone_signature">
        <ab><hi rendition="#c #b #in"><lb/><orgName>A/S Chr. Winther</orgName></hi></ab>
      </div>
      <div facs="#zone_phone">
        <ab><hi rendition="#c #b"><lb/>Telf. 4876.
          <lb/>Grundlagt 1885.</hi></ab>
      </div>
    </body>
